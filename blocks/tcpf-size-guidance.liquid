{% assign garment = closest.product.metafields.tcpf.apparel_details.value %}
{% if garment.size_charts.value != blank %}
  <details class="tcpf-size-disclosure" {{ block.shopify_attributes }}>
    <summary>{{ block.settings.heading | escape }}</summary>
    <div class="tcpf-size-disclosure__content">
      {% for guide in garment.size_charts.value %}
        {% assign guide_prefix = section.id | append: '-' | append: block.id | append: '-' | append: forloop.index %}
        {% render 'tcpf-size-table', guide: guide, id_prefix: guide_prefix %}
      {% endfor %}
      {% if block.settings.link != blank %}<a class="tcpf-link" href="{{ block.settings.link }}">All size guides</a>{% endif %}
    </div>
  </details>
{% elsif request.design_mode %}<p class="tcpf-note" {{ block.shopify_attributes }}>Add size-guide references to the product’s TCPF Garment Details.</p>{% endif %}
{% schema %}
{
  "name": "TCPF size guidance",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size and fit guide"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Full guide page"
    }
  ],
  "presets": [
    {
      "name": "TCPF size guidance"
    }
  ]
}
{% endschema %}
