<section class="tcpf-story-panel">
  <div class="tcpf-wrap tcpf-story-panel__grid">
    {% if section.settings.image != blank %}<div class="tcpf-story-panel__image">{{ section.settings.image | image_url: width: 1000 | image_tag: widths: '320,480,640,800,1000', sizes: '(max-width: 749px) 90vw, 45vw', loading: 'lazy', alt: section.settings.image.alt }}</div>{% endif %}
    <div class="tcpf-story-panel__content">
      <p class="tcpf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="tcpf-heading">{{ section.settings.heading | escape }}</h2>
      <div class="tcpf-copy">{{ section.settings.copy }}</div>
      {% if section.settings.link != blank %}<a class="tcpf-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}
      {% if section.settings.caption != blank %}<p class="tcpf-note">{{ section.settings.caption | escape }}</p>{% endif %}
    </div>
  </div>
</section>
{% stylesheet %}
  .tcpf-story-panel { background: var(--tcpf-lilac); color: var(--color-foreground); padding-block: var(--tcpf-space); }
  .tcpf-story-panel__grid { display: grid; grid-template-columns: minmax(0,1.05fr) minmax(0,1fr); gap: clamp(32px,6vw,88px); align-items: center; }
  .tcpf-story-panel__grid > * { min-width: 0; }
  .tcpf-story-panel__image img { display: block; width: 100%; height: auto; }
  .tcpf-story-panel__content .tcpf-copy { margin-top: 28px; }
  .tcpf-story-panel .tcpf-note { color: inherit; margin-top: 24px; }
  @media(max-width:749px) { .tcpf-story-panel__grid { grid-template-columns: minmax(0,1fr); } }
{% endstylesheet %}
{% schema %}
{
  "name": "TCPF story panel",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Tisha Chavez Painted Fashion"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Art is part of the everyday."
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Story",
      "default": "<p>Based in Naga City, TCPF brings original artworks into modern Filipiniana clothing. Founded and operated by Tisha Chavez, the boutique connects expressive prints with pieces made to be worn.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Artwork or garment image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image attribution"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Our story"
    }
  ],
  "presets": [
    {
      "name": "TCPF story panel"
    }
  ]
}
{% endschema %}
