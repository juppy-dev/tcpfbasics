<section class="tcpf-section tcpf-wrap" aria-labelledby="tcpf-edit-{{ section.id }}">
  <div class="tcpf-section-head">
    <div><p class="tcpf-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="tcpf-heading" id="tcpf-edit-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
    {% if section.settings.collection != blank %}<a class="tcpf-link" href="{{ section.settings.collection.url }}">View all pieces</a>{% endif %}
  </div>
  {% if section.settings.collection.products_count > 0 %}
    <div class="tcpf-grid">
      {% for product in section.settings.collection.products limit: section.settings.count %}
        <div>{% content_for 'block', type: '_product-card', id: 'tcpf-edit-card', closest.product: product, product_view_context: 'collection' %}</div>
      {% endfor %}
    </div>
  {% else %}
    <p class="tcpf-empty">{% if request.design_mode %}Choose a collection with storefront-visible products.{% else %}This edit is being prepared. Explore the collections above.{% endif %}</p>
  {% endif %}
</section>
{% schema %}
{
  "name":"TCPF ready-to-wear edit",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"The ready-to-wear edit"},
    {"type":"text","id":"heading","label":"Heading","default":"Find your next piece."},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"count","label":"Products","min":4,"max":12,"step":4,"default":8}
  ],
  "presets":[{"name":"TCPF ready-to-wear edit"}]
}
{% endschema %}
