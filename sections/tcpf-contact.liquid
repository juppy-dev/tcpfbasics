{% assign form_id = 'TCPFContact-' | append: section.id %}
<section class="tcpf-section tcpf-wrap tcpf-contact">
  <div class="tcpf-contact__aside">
    <p class="tcpf-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="tcpf-heading">{{ section.settings.heading | escape }}</h2>
    <div class="tcpf-copy">{{ section.settings.copy }}</div>
    {% if section.settings.contact_details != blank %}<div class="tcpf-copy">{{ section.settings.contact_details }}</div>{% endif %}
  </div>
  {% form 'contact', id: form_id, class: 'tcpf-contact__form' %}
    <input name="contact[id]" type="hidden" value="{{ form_id }}">
    <input name="contact[Inquiry type]" type="hidden" value="{% if section.settings.bespoke %}Bespoke inquiry{% else %}General inquiry{% endif %}">
    {% liquid
      assign form_matches = false
      if form.id == form_id or form.id == blank
        assign form_matches = true
      endif
    %}
    {% if form.errors and form_matches %}
      <div id="{{ form_id }}-errors" class="tcpf-form-status" role="alert">{{ form.errors | default_errors }}</div>
    {% endif %}
    {% if form.posted_successfully? and form_matches %}
      <p class="tcpf-form-status" role="status">{{ 'blocks.contact_form.post_success' | t }}</p>
    {% endif %}
    <p class="tcpf-note">Fields marked * are required.</p>
    <div class="tcpf-form-row">
      <div><label for="{{ form_id }}-name">Name *</label><input id="{{ form_id }}-name" name="contact[name]" autocomplete="name" required value="{{ form.name | default: customer.name | escape }}"></div>
      <div><label for="{{ form_id }}-email">Email *</label><input type="email" id="{{ form_id }}-email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required value="{{ form.email | default: customer.email | escape }}" {% if form.errors contains 'email' and form_matches %}aria-invalid="true" aria-describedby="{{ form_id }}-errors"{% endif %}></div>
    </div>
    <div><label for="{{ form_id }}-phone">Phone (optional)</label><input type="tel" id="{{ form_id }}-phone" name="contact[phone]" autocomplete="tel" value="{{ form.phone | escape }}"></div>
    {% if section.settings.bespoke %}
      <div class="tcpf-form-row">
        <div><label for="{{ form_id }}-garment">Garment interest (optional)</label><select id="{{ form_id }}-garment" name="contact[Garment interest]"><option value="">Select a garment</option><option>Bolero</option><option>Terno set</option><option>Skirt</option><option>Dress</option><option>Top</option><option>Still exploring</option></select></div>
        <div><label for="{{ form_id }}-date">Occasion date (optional)</label><input type="date" id="{{ form_id }}-date" name="contact[Occasion date]"></div>
      </div>
    {% endif %}
    <div><label for="{{ form_id }}-body">{% if section.settings.bespoke %}Tell us about your idea *{% else %}Your message *{% endif %}</label><textarea id="{{ form_id }}-body" name="contact[body]" rows="7" required>{{ form.body | escape }}</textarea></div>
    {% if section.settings.bespoke %}<p class="tcpf-note">An inquiry starts a conversation. Price, feasibility, and timing are discussed before a commitment.</p>{% endif %}
    <div><button class="tcpf-button" type="submit">{{ section.settings.submit_label | escape }}</button></div>
  {% endform %}
</section>
{% stylesheet %}
  .tcpf-contact { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.4fr); gap: clamp(32px,7vw,96px); padding-top: 28px; }
  .tcpf-contact > * { min-width: 0; }
  .tcpf-contact__aside .tcpf-copy { margin-top: 26px; }
  .tcpf-contact__form { display: flex; flex-direction: column; gap: 22px; }
  .tcpf-contact__form .tcpf-note { margin: 0; }
  .tcpf-form-row { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 18px; }
  .tcpf-form-row > * { min-width: 0; }
  .tcpf-contact label { display: block; font-size: 14px; font-weight: 500; margin-bottom: 8px; }
  .tcpf-contact :is(input:not([type=hidden]),select,textarea) { width: 100%; max-width: 100%; min-width: 0; padding: 12px 14px; min-height: 48px; font: 400 16px/1.5 var(--font-body--family); color: var(--color-foreground); background: var(--color-background); border: 1px solid var(--tcpf-muted); border-radius: 3px; }
  .tcpf-contact textarea { resize: vertical; }
  .tcpf-form-status { padding: 20px; border: 1px solid var(--tcpf-plum); background: var(--tcpf-petal); font-size: 15px; }
  @media(max-width:749px) { .tcpf-contact { grid-template-columns: minmax(0,1fr); } .tcpf-form-row { grid-template-columns: minmax(0,1fr); } }
{% endstylesheet %}
{% schema %}
{"name":"TCPF contact and bespoke","enabled_on":{"templates":["page"]},"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Let’s talk"},{"type":"text","id":"heading","label":"Heading","default":"A note to TCPF."},{"type":"richtext","id":"copy","label":"Introduction","default":"<p>Ask about a piece, share an idea, or tell us what you’re looking for.</p>"},{"type":"richtext","id":"contact_details","label":"Verified contact details","info":"Add only client-confirmed details."},{"type":"checkbox","id":"bespoke","label":"Show bespoke fields","default":false},{"type":"text","id":"submit_label","label":"Submit label","default":"Send your message"}],"presets":[{"name":"TCPF contact and bespoke"}]}
{% endschema %}
