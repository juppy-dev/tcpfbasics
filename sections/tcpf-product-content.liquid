{% liquid
  assign garment = product.metafields.tcpf.apparel_details.value
  assign artwork = product.metafields.tcpf.design_concept.value
  assign components = product.metafields.tcpf.set_components.value
  assign related = product.metafields.tcpf.related_products.value
  assign relationship = product.metafields.tcpf.related_products_context.value
  assign related_heading = blank
  if relationship == 'outfit'
    assign related_heading = 'Complete the look'
  elsif relationship == 'same_artwork'
    assign related_heading = 'More in this print'
  endif
%}
{% capture component_cards %}
  {% for piece in components %}
    {% if piece != blank and piece.id != product.id %}<div>{% content_for 'block', type: '_product-card', id: 'tcpf-component-card', closest.product: piece, product_view_context: 'product' %}</div>{% endif %}
  {% endfor %}
{% endcapture %}
{% assign component_cards = component_cards | strip %}
{% capture related_cards %}
  {% for piece in related %}
    {% if piece != blank and piece.id != product.id %}<div>{% content_for 'block', type: '_product-card', id: 'tcpf-related-card', closest.product: piece, product_view_context: 'product' %}</div>{% endif %}
  {% endfor %}
{% endcapture %}
{% assign related_cards = related_cards | strip %}
{% if garment != blank or artwork != blank %}
  <section class="tcpf-section tcpf-wrap tcpf-product-story">
    {% if garment != blank %}
      <div class="tcpf-product-facts">
        <div><p class="tcpf-eyebrow">The garment</p><h2 class="tcpf-heading">{{ section.settings.facts_heading | escape }}</h2>{% if garment.data_status.value == 'sample' %}<p class="tcpf-note">Demonstration specifications. Physical garment details require verification.</p>{% endif %}</div>
        <dl>
          {% assign facts = 'Silhouette:silhouette|Fit:fit_notes|Fabric:fabric|Composition:fiber_content|Stretch:stretch|Lining:lining|Fastening:closure|Pockets:pockets|Care:care_instructions|Included pieces:included_items' | split: '|' %}
          {% for fact in facts %}
            {% assign pair = fact | split: ':' %}
            {% assign field_key = pair[1] %}
            {% assign field = garment[field_key].value %}
            {% if field != blank %}<div><dt>{{ pair[0] }}</dt><dd>{{ field | escape | newline_to_br }}</dd></div>{% endif %}
          {% endfor %}
        </dl>
      </div>
    {% endif %}
    {% if artwork != blank %}
      <article class="tcpf-product-artwork">
        {% if artwork.artwork_image.value != blank %}<figure>{{ artwork.artwork_image.value | image_url: width: 800 | image_tag: widths: '320,480,640,800', sizes: '(max-width: 749px) 90vw, 40vw', loading: 'lazy', class: 'tcpf-image', alt: artwork.artwork_image.value.alt }}{% if artwork.attribution.value != blank %}<figcaption class="tcpf-note">{{ artwork.attribution.value | escape }}</figcaption>{% endif %}</figure>{% endif %}
        <div>
          <p class="tcpf-eyebrow">The artwork behind the print</p><h2 class="tcpf-heading">{{ artwork.title.value | escape }}</h2>
          {% if artwork.story.value != blank %}<p class="tcpf-copy">{{ artwork.story.value | escape | newline_to_br }}</p>{% endif %}
          {% if artwork.palette.value != blank %}<p class="tcpf-note">Palette: {{ artwork.palette.value | join: ', ' | escape }}</p>{% endif %}
          {% if artwork.medium.value != blank %}<p class="tcpf-note">{{ artwork.medium.value | escape }}</p>{% endif %}
          {% if artwork.origin.value == 'ai_concept' %}<p class="tcpf-note">AI-generated demonstration artwork. Artist attribution is pending client review.</p>{% endif %}
        </div>
      </article>
    {% endif %}
  </section>
{% endif %}
{% if component_cards != blank %}
  <section class="tcpf-section tcpf-wrap" aria-labelledby="tcpf-components-{{ section.id }}">
    <p class="tcpf-eyebrow">The complete outfit</p><h2 class="tcpf-heading" id="tcpf-components-{{ section.id }}">{{ section.settings.components_heading | escape }}</h2>
    <p class="tcpf-copy">Explore each piece individually. Set contents are described above; styling accessories are excluded.</p>
    <div class="tcpf-grid">
      {{ component_cards }}
    </div>
  </section>
{% endif %}
{% if related_cards != blank and related_heading != blank %}
  <section class="tcpf-section tcpf-wrap" aria-labelledby="tcpf-related-{{ section.id }}">
    <div class="tcpf-section-head"><h2 class="tcpf-heading" id="tcpf-related-{{ section.id }}">{{ related_heading }}</h2></div>
    <div class="tcpf-grid">
      {{ related_cards }}
    </div>
  </section>
{% endif %}
{% stylesheet %}
  .tcpf-product-facts { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.5fr); gap: 60px; }
  .tcpf-product-facts > * { min-width: 0; }
  .tcpf-product-facts dl { margin: 0; }
  .tcpf-product-facts dl > div { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2.5fr); gap: 24px; padding-block: 18px; border-bottom: 1px solid var(--tcpf-line); font-size: 15px; line-height: 1.65; }
  .tcpf-product-facts dt { font-weight: 600; }
  .tcpf-product-facts dd { margin: 0; }
  .tcpf-product-artwork { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: clamp(32px,7vw,96px); align-items: center; margin-top: var(--tcpf-space); }
  .tcpf-product-artwork > * { min-width: 0; }
  .tcpf-product-artwork figure { margin: 0; }
  .tcpf-product-artwork figcaption { margin-top: 14px; }
  .tcpf-product-artwork .tcpf-copy { margin-top: 28px; }
  @media(max-width:749px) { .tcpf-product-facts, .tcpf-product-artwork { grid-template-columns: minmax(0,1fr); gap: 30px; } .tcpf-product-facts dl > div { grid-template-columns: minmax(0,1fr); gap: 6px; } }
{% endstylesheet %}
{% schema %}
{"name":"TCPF product stories","enabled_on":{"templates":["product"]},"settings":[{"type":"text","id":"facts_heading","label":"Garment facts heading","default":"A closer look at your piece."},{"type":"text","id":"components_heading","label":"Set pieces heading","default":"Two pieces. Worn together or apart."}]}
{% endschema %}
