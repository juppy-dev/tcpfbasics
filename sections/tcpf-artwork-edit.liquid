<section class="tcpf-section tcpf-wrap" aria-labelledby="tcpf-art-edits-{{ section.id }}">
  <div class="tcpf-section-head"><div><p class="tcpf-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="tcpf-heading" id="tcpf-art-edits-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div><p class="tcpf-copy">{{ section.settings.copy | escape }}</p></div>
  <div class="tcpf-art-edits">
    {% for block in section.blocks %}
      {% liquid
        assign edit = block.settings.collection
        assign artwork = edit.metafields.tcpf.artworks.value | first
        assign master = artwork.artwork_image.value
        assign garment_image = block.settings.image | default: edit.image
      %}
      {% if edit != blank %}
        <article class="tcpf-art-edit" {{ block.shopify_attributes }}>
          <a class="tcpf-art-edit__images" href="{{ edit.url }}" aria-label="Explore {{ edit.title | escape }}">
            {% if garment_image != blank %}{{ garment_image | image_url: width: 900 | image_tag: widths: '320,480,640,900', sizes: '(max-width: 749px) 78vw, 38vw', loading: 'lazy', class: 'tcpf-art-edit__garment', alt: '' }}{% endif %}
            {% if master != blank %}{{ master | image_url: width: 480 | image_tag: widths: '180,280,360,480', sizes: '(max-width: 749px) 28vw, 14vw', loading: 'lazy', class: 'tcpf-art-edit__master', alt: master.alt }}{% endif %}
          </a>
          <div class="tcpf-art-edit__caption"><h3>{{ edit.title | escape }}</h3><a class="tcpf-link" href="{{ edit.url }}">Explore the print</a></div>
          {% if artwork.origin.value == 'ai_concept' %}<p class="tcpf-note">AI-generated sample artwork · {{ artwork.title.value | escape }}</p>{% elsif artwork.attribution.value != blank %}<p class="tcpf-note">{{ artwork.attribution.value | escape }}</p>{% endif %}
        </article>
      {% elsif request.design_mode %}<p class="tcpf-empty" {{ block.shopify_attributes }}>Choose an artwork collection.</p>{% endif %}
    {% endfor %}
  </div>
</section>
{% stylesheet %}
  .tcpf-art-edits { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 44px; }
  .tcpf-art-edit { min-width: 0; }
  .tcpf-art-edit:nth-child(even) { margin-top: 70px; }
  .tcpf-art-edit__images { position: relative; display: block; padding-right: 13%; }
  .tcpf-art-edit__garment { display: block; width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; }
  .tcpf-art-edit__master { position: absolute; bottom: 10%; right: 0; width: 39%; height: auto; border: 8px solid var(--color-background); box-shadow: 0 8px 20px #26231f12; }
  .tcpf-art-edit__caption { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 20px; }
  .tcpf-art-edit__caption h3 { font: 400 clamp(26px,3vw,38px)/1.2 var(--font-heading--family); margin: 0; }
  @media(max-width:749px) { .tcpf-art-edits { grid-template-columns: minmax(0,1fr); gap: 38px; } .tcpf-art-edit:nth-child(even) { margin-top: 0; } .tcpf-art-edit__caption { gap: 12px; } .tcpf-art-edit__caption .tcpf-link { font-size: 14px; } }
{% endstylesheet %}
{% schema %}
{
  "name":"TCPF artwork edits",
  "settings":[
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"From artwork to outfit"},
    {"type":"text","id":"heading","label":"Heading","default":"A print worth a closer look."},
    {"type":"textarea","id":"copy","label":"Introduction","default":"Discover the artwork behind the pieces, then find your way to wear it."}
  ],
  "blocks":[{"type":"edit","name":"Artwork edit","settings":[{"type":"collection","id":"collection","label":"Artwork collection"},{"type":"image_picker","id":"image","label":"Garment photograph","info":"The painting comes from the collection’s TCPF artwork reference."}]}],
  "max_blocks":2,
  "presets":[{"name":"TCPF artwork edits","blocks":[{"type":"edit"},{"type":"edit"}]}]
}
{% endschema %}
